; Engine configuration file.
; Godot 4.7.2 project for the EMPIRE RUSH client (and, pending the M3 spike,
; possibly the headless authoritative server). Edit through the Godot editor
; where possible.

config_version=5

[application]

config/name="Empire Rush"
config/description="Mobile-first online strategy-party board game."
config/version="0.0.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
