## 3D miniature-city board (M2.3 production kit, Phase 5 tabletop). The board
## is assembled from baked kit assets in client/assets/models/ (generated by
## client/tools/asset_forge, see docs/art_direction/ART_DIRECTION.md): a
## walnut diorama plinth on a night-blue tabletop, marble tile slabs, district
## bands, a road ring, the city centre and per-district buildings (levels 1-3).
## All static pieces are merged into ONE mesh (MeshMerger.add_kit) so the
## board stays a handful of draw calls.
## Pure presentation: it is told what to show, it never reads rules state.
class_name BoardView
extends Node3D

const TILE_H := 0.126          # top of the marble slab
const BOARD_H := 0.46
## Buildings are authored for a 0.56 m lot; shown slightly larger so the
## upgrade level reads at phone size.
const BUILDING_SCALE := 1.1
const KIT := "res://assets/models/kit/%s.res"
const BUILDING := "res://assets/models/buildings/%s_l%d.res"
const ICON := "res://assets/ui/icons/%s.svg"
## Tile marker kinds (presentation state, see set_tile_marker()).
const MARKERS := {"auction": ["gavel", Color("#ffcf5a")], "upgrade": ["arrow_up", Color("#7be38f")]}

var config: GameConfig
var theme: ThemeData
var _tiles: Array[Node3D] = []
var _lots: Dictionary = {}        # property_id -> Node3D (building anchor)
var _lot_tile: Dictionary = {}    # property_id -> tile index
var _owner_marks: Dictionary = {} # property_id -> MeshInstance3D
var _owner_badges: Dictionary = {} # property_id -> Sprite3D (owner portrait badge)
var _levels: Dictionary = {}      # property_id -> int shown
var _markers: Dictionary = {}     # "kind:index" -> Sprite3D
var _price_labels: Dictionary = {} # property_id -> Label3D (unowned tiles)
var _highlight: Node3D
var _rng := RandomNumberGenerator.new()  # decoration only, never rules
var _kit_cache: Dictionary = {}
var _table: MeshInstance3D
## Static geometry is merged into two meshes: flat ground (slabs, roads,
## quay, tile tops) that only RECEIVES shadows, and upright props (trees,
## lamps, blocks, boats) that also CAST them. The shadow pass then skips
## ~two thirds of the board's triangles (Phase 2 profiling).
var _ground: MeshMerger
var _props: MeshMerger
## Pieces that lie flat on the board: merged into the ground mesh.
const GROUND_PIECES := ["tile_base", "tile_top", "lot_plaza", "pier"]


func kit(name: String) -> Mesh:
	if not _kit_cache.has(name):
		_kit_cache[name] = load(KIT % name)
	return _kit_cache[name]


func build(p_config: GameConfig, p_theme: ThemeData) -> void:
	config = p_config
	theme = p_theme
	_rng.seed = 2026
	_build_table()
	_ground = MeshMerger.new()
	_props = MeshMerger.new()
	_build_plinth(_ground)
	_build_streets(_ground)
	_build_center_city(_ground)
	for i in config.board_size():
		_build_tile(i, _ground)
	var ground := _ground.instance("StaticBoard")
	ground.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	add_child(ground)
	add_child(_props.instance("StaticProps"))
	_ground = null
	_props = null
	_build_highlight()


## Box from a unit kit cube (any material), scaled to `size`.
func _ubox(st: MeshMerger, material: String, size: Vector3, pos: Vector3, tint := Color.WHITE, rot_y := 0.0) -> void:
	# Scale in the box's own axes, then rotate (Basis.scaled() would scale in
	# world axes and break rotated strips).
	st.add_kit(kit("unit_" + material), Transform3D(Basis(Vector3.UP, rot_y) * Basis.from_scale(size), pos), tint)


func _place(st: MeshMerger, piece: String, pos: Vector3, rot_y := 0.0, scale := 1.0, tint := Color.WHITE) -> void:
	if not piece in GROUND_PIECES and _props != null:
		st = _props
		var r := _blob_radius(piece)
		if r > 0.0:
			_blob(pos, r * scale)
	st.add_kit(kit(piece), Transform3D(Basis(Vector3.UP, rot_y) * Basis.from_scale(Vector3.ONE * scale), pos), tint)


## Mobile visual pass: soft contact shadows (a dark radial blob on the ground
## under each object) give the diorama the grounded depth that screen-space
## ambient occlusion would; the web renderer (Compatibility) has no SSAO.
## They are merged into the ground mesh: no extra draw calls per object.
const CONTACT_SHADOW := "res://assets/materials/contact_shadow.tres"
static var _blob_plane: PlaneMesh

func _blob_radius(piece: String) -> float:
	if piece.begins_with("bg_block"):
		return 0.42
	if piece.begins_with("tree"):
		return 0.2
	if piece == "landmark":
		return 0.8
	if piece in ["planter", "bench", "fountain"]:
		return 0.17
	return 0.0


func _blob(pos: Vector3, radius: float, strength := 0.75) -> void:
	if _ground == null:
		return
	if _blob_plane == null:
		_blob_plane = PlaneMesh.new()
		_blob_plane.size = Vector2.ONE
	_ground.add_mesh(_blob_plane, Transform3D(Basis.from_scale(Vector3(radius * 2.0, 1.0, radius * 2.0)), pos + Vector3(0, 0.004, 0)),
		Color(1, 1, 1, strength), CONTACT_SHADOW)


## Same blob as its own node (buildings placed during play).
static func contact_shadow_node(radius: float, strength := 0.75) -> MeshInstance3D:
	var mi := MeshInstance3D.new()
	mi.name = "ContactShadow"
	var pm := PlaneMesh.new()
	pm.size = Vector2.ONE * radius * 2.0
	mi.mesh = pm
	var m := (load(CONTACT_SHADOW) as StandardMaterial3D).duplicate() as StandardMaterial3D
	m.vertex_color_use_as_albedo = false
	m.albedo_color = Color(1, 1, 1, strength)
	mi.material_override = m
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	mi.position.y = 0.003
	return mi


# --- environment ---------------------------------------------------------------

## Phase 5: a dark tabletop under the diorama (tabletop.gdshader) instead of
## the full-screen cyan harbour water: depth, a pool of light around the board
## and a contact shadow, so the tiles carry the colour.
func _build_table() -> void:
	var w := MeshInstance3D.new()
	var pm := PlaneMesh.new()
	pm.size = Vector2(80, 80)
	w.mesh = pm
	w.position.y = -BOARD_H - 0.05
	var sh := ShaderMaterial.new()
	sh.shader = load("res://scripts/presentation/tabletop.gdshader")
	w.material_override = sh
	w.name = "Table"
	_table = w
	w.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	add_child(w)


## Diorama plinth: a walnut base with a gold inlay line and a darker foot, a
## paved promenade around the tile ring with bollards and lamps.
func _build_plinth(st: MeshMerger) -> void:
	var walnut := Color("#4a3426")
	_ubox(st, "wood", Vector3(8.8, BOARD_H, 8.8), Vector3(0, -BOARD_H * 0.5, 0), walnut)
	# Foot: slightly wider and darker, so the base reads as a separate piece.
	_ubox(st, "wood", Vector3(8.96, 0.08, 8.96), Vector3(0, -BOARD_H + 0.03, 0), walnut.darkened(0.45))
	# Second, thinner inlay above the foot: the deeper plinth reads as a
	# crafted base, not a slab.
	for s in [-1, 1]:
		_ubox(st, "gold", Vector3(8.82, 0.012, 0.01), Vector3(0, -BOARD_H + 0.1, s * 4.401), Color("#b8862f"))
		_ubox(st, "gold", Vector3(0.01, 0.012, 8.82), Vector3(s * 4.401, -BOARD_H + 0.1, 0), Color("#b8862f"))
	# Gold inlay just under the top edge, on all four sides.
	for s in [-1, 1]:
		_ubox(st, "gold", Vector3(8.82, 0.022, 0.01), Vector3(0, -0.07, s * 4.401), Color("#d9a441"))
		_ubox(st, "gold", Vector3(0.01, 0.022, 8.82), Vector3(s * 4.401, -0.07, 0), Color("#d9a441"))
	_ubox(st, "paving", Vector3(8.7, 0.02, 8.7), Vector3(0, -0.005, 0), Color("#b8b0a2"))
	# Ivory coping along the top edge frames the board.
	for s in [-1, 1]:
		_ubox(st, "marble", Vector3(8.84, 0.04, 0.09), Vector3(0, 0.0, s * 4.37), Color("#efe6d2"))
		_ubox(st, "marble", Vector3(0.09, 0.04, 8.84), Vector3(s * 4.37, 0.0, 0), Color("#efe6d2"))
	# Bollards and lamps on the promenade (skipping the Start corner).
	for k in 13:
		var t := -3.6 + k * 0.6
		for side in 4:
			var p := _edge_point(side, t, 4.17)
			if p.distance_to(BoardLayout.position_of(0)) < 0.9:
				continue
			_place(st, "bollard" if k % 2 == 0 else "streetlight", p, _edge_rot(side), 1.0)


func _edge_point(side: int, t: float, r: float) -> Vector3:
	match side:
		0: return Vector3(t, 0, r)
		1: return Vector3(-r, 0, t)
		2: return Vector3(t, 0, -r)
	return Vector3(r, 0, t)


func _edge_rot(side: int) -> float:
	return [0.0, PI * 0.5, PI, -PI * 0.5][side]


## Road ring inside the tiles, sidewalk, avenues to the central plaza.
func _build_streets(st: MeshMerger) -> void:
	var road := Color("#5a5e66")
	var walk := Color("#d8d0c0")
	# Sidewalk square, then the asphalt ring, then the park.
	_ubox(st, "paving", Vector3(6.0, 0.03, 6.0), Vector3(0, 0.005, 0), walk)
	for s in [-1, 1]:
		_ubox(st, "asphalt", Vector3(5.86, 0.012, 0.34), Vector3(0, 0.026, s * 2.78), road)
		_ubox(st, "asphalt", Vector3(0.34, 0.012, 5.86), Vector3(s * 2.78, 0.026, 0), road)
		# Dashed centre line.
		for k in 14:
			var t := -2.6 + k * 0.4
			_ubox(st, "paint", Vector3(0.16, 0.004, 0.018), Vector3(t, 0.034, s * 2.78), Color("#f4f1e6"))
			_ubox(st, "paint", Vector3(0.018, 0.004, 0.16), Vector3(s * 2.78, 0.034, t), Color("#f4f1e6"))
	_ubox(st, "grass", Vector3(5.1, 0.04, 5.1), Vector3(0, 0.03, 0), Color("#7aa95f"))
	# Avenues and the central plaza.
	_ubox(st, "paving", Vector3(5.1, 0.012, 0.36), Vector3(0, 0.054, 0), walk)
	_ubox(st, "paving", Vector3(0.36, 0.012, 5.1), Vector3(0, 0.054, 0), walk)
	_ubox(st, "paving", Vector3(1.6, 0.014, 1.6), Vector3(0, 0.056, 0), Color("#e2dacb"), PI * 0.25)
	# Lamps along the inner sidewalk.
	for k in 5:
		var t := -1.6 + k * 0.8  # corners stay clear (no doubled lamps)
		for side in 4:
			_place(st, "streetlight", _edge_point(side, t, 2.52), _edge_rot(side) + PI)


## Decorative city centre (not gameplay): landmark, fountains, four city
## blocks of background buildings, trees, benches and planters.
func _build_center_city(st: MeshMerger) -> void:
	# Phase 5.1: the landmark stands on a round dais (walnut, gold rim, marble
	# top) in warm stone instead of plain white, ringed by flags in the
	# district colours, so the centre reads as the city's showpiece.
	_dais(st)
	_place(st, "landmark", Vector3(0, 0.12, 0), 0.0, 1.0, Color("#f3e2c0"))
	for q in [Vector3(1, 0, 1), Vector3(-1, 0, 1), Vector3(1, 0, -1), Vector3(-1, 0, -1)]:
		# The quadrant facing the camera (+x,+z) gets the taller blocks; the
		# far one stays low so it never hides tiles on the far edge.
		var near: bool = q.x > 0 and q.z > 0
		var far: bool = q.x < 0 and q.z < 0
		# Phase 5: a richer skyline - the district architecture (muted, so it
		# never reads as a tile's building) mixed with the background blocks.
		# Tall pieces on the quadrant facing the camera, low ones far away.
		var mix: Array = (["d6_l3", "bg_block_3", "d4_l2"] if near else
			(["d1_l1", "bg_block_0", "d3_l1"] if far else
			(["d6_l2", "bg_block_2", "d1_l2"] if q.x > 0 else ["d7_l2", "bg_block_1", "d2_l1"])))
		var slots := [Vector3(1.05, 0, 1.05), Vector3(1.95, 0, 1.05), Vector3(1.05, 0, 1.95), Vector3(1.95, 0, 1.95)]
		for i in 4:
			var p: Vector3 = slots[i] * q + Vector3(0, 0.05, 0)
			if i == 3:
				# A small park (the bare fountain read as an empty beige disc).
				for k in 4:
					var a := k * TAU / 4.0 + 0.4
					_place(st, "tree_round_%d" % (k % 3) if k < 3 else "tree_cone", p + Vector3(cos(a), 0, sin(a)) * 0.24, 0.0, 0.9)
				_place(st, "planter", p, 0.0, 1.2)
				continue
			var piece: String = mix[i]
			var rot := _rng.randi_range(0, 3) * PI * 0.5
			if piece.begins_with("bg_"):
				_place(st, piece, p, rot, 0.9)
			else:
				var parts := piece.split("_l")
				var mesh: Mesh = load(BUILDING % [parts[0], int(parts[1])])
				_blob(p, 0.4)
				_props.add_kit(mesh, Transform3D(Basis(Vector3.UP, rot) * Basis.from_scale(Vector3.ONE * 0.95), p), Color(0.9, 0.9, 0.93))
		# Street trees along the avenues.
		for k in 4:
			var t := 0.7 + k * 0.5
			_place(st, "tree_round_%d" % (k % 3), Vector3(t * q.x, 0.05, 0.3 * q.z), 0.0, 0.9)
			_place(st, ("tree_cone" if k % 2 == 0 else "tree_round_1"), Vector3(0.3 * q.x, 0.05, t * q.z), 0.0, 0.85)
		_place(st, "bench", Vector3(1.5 * q.x, 0.05, 0.42 * q.z), PI if q.z > 0 else 0.0)
		_place(st, "planter", Vector3(0.7 * q.x, 0.06, 0.7 * q.z))


func _dais(st: MeshMerger) -> void:
	var seg := 28
	for r in [[0.64, 0.035, "wood", Color("#5a4030")], [0.61, 0.06, "gold", Color("#e9bd4c")], [0.55, 0.07, "marble", Color("#efe6d6")]]:
		var rad: float = r[0]
		var h: float = r[1]
		for k in seg:
			var a := k * TAU / seg
			var w := 2.0 * rad * sin(PI / seg) * 1.08
			_ubox(st, r[2], Vector3(w, h, rad), Vector3(cos(a), 0, sin(a)) * rad * 0.5 + Vector3(0, 0.05 + h * 0.5, 0), r[3], -a + PI * 0.5)
	var dids: Array = theme.districts.keys()
	for k in 8:
		var a := k * TAU / 8.0 + PI / 8.0
		var p := Vector3(cos(a), 0, sin(a)) * 0.6 + Vector3(0, 0.11, 0)
		var col: Color = theme.district_color(dids[k % dids.size()])
		_props.add_kit(kit("flag_pole"), Transform3D(Basis(Vector3.UP, -a) * Basis.from_scale(Vector3.ONE * 1.2), p), Color.WHITE)
		_props.add_kit(kit("flag_cloth"), Transform3D(Basis(Vector3.UP, -a) * Basis.from_scale(Vector3.ONE * 1.2), p), col)


# --- tiles -----------------------------------------------------------------------

func _build_tile(i: int, st: MeshMerger) -> void:
	var root := Node3D.new()
	root.name = "Tile%02d" % i
	root.position = BoardLayout.position_of(i)
	add_child(root)
	_tiles.append(root)
	var sp: Dictionary = config.spaces[i]
	var stype: String = sp["space_type"]
	# Corner tiles point diagonally inwards; orient their band like the next
	# tile on the ring so it stays axis-aligned.
	var inward := BoardLayout.inward((i + 1) % config.board_size() if BoardLayout.is_corner(i) else i)
	var flat_in := Vector3(signf(inward.x) if absf(inward.x) > 0.5 else 0.0, 0, signf(inward.z) if absf(inward.z) > 0.5 else 0.0)
	var rot := atan2(flat_in.x, flat_in.z) if flat_in != Vector3.ZERO else 0.0
	st.add_kit(kit("tile_base"), Transform3D(Basis(), root.position))
	var top_tint := Color("#f6f1e7")
	var accent: Color
	if stype == "PROPERTY":
		accent = theme.district_color(sp["district_id"])
		# Phase 5: a light wash of the district colour over the whole slab, so
		# districts read from the overview camera (not only the thin band).
		top_tint = accent.lerp(Color("#fbf7ef"), 0.5)
	else:
		accent = Color(theme.special[stype]["color"])
		top_tint = accent.lerp(Color("#fbf7ef"), 0.62)
	st.add_kit(kit("tile_top"), Transform3D(Basis(), root.position), top_tint)
	# Pick body for tap-to-inspect (no rendering cost).
	var body := StaticBody3D.new()
	body.set_meta("tile_index", i)
	var shape := CollisionShape3D.new()
	var bs := BoxShape3D.new()
	bs.size = Vector3(0.94, 0.6, 0.94)
	shape.shape = bs
	shape.position.y = 0.3
	body.add_child(shape)
	root.add_child(body)
	if stype == "PROPERTY":
		# District colour band on the inner (street) edge with a gold trim:
		# the classic board read, kept narrow so buildings stay visible.
		# Mobile visual pass: the band is narrower (0.14 instead of 0.24) so the
		# price plate fits in the middle of the tile without touching it.
		var band_pos := root.position + flat_in * BAND_CENTER + Vector3(0, TILE_H + 0.008, 0)
		var band := Vector3(0.86, 0.016, BAND_DEPTH)
		_ubox(st, "paint", band, band_pos, accent, rot)
		_ubox(st, "gold", Vector3(0.86, 0.018, 0.016), band_pos - flat_in * (BAND_DEPTH * 0.5 + 0.005), Color("#e2b448"), rot)
		var lot := Node3D.new()
		lot.position = -flat_in * 0.1 + Vector3(0, TILE_H, 0)
		lot.rotation.y = rot + PI  # buildings face outwards, towards the water
		root.add_child(lot)
		# Phase 5.1: the paved lot takes a wash of the district colour too (it
		# covered most of the tile in plain ivory: the board read as white).
		_place(st, "lot_plaza", root.position + lot.position + Vector3(0, 0.001, 0), rot, 0.95, accent.lerp(Color("#fbf7ef"), 0.62))
		_lots[sp["property_id"]] = lot
		_lot_tile[sp["property_id"]] = i
		_levels[sp["property_id"]] = -1
		_build_price_label(root, sp["property_id"], accent)
	else:
		_build_special_icon(root, stype, accent)


## The purchase price of every unowned property, on a dark plate with a rim
## in the district colour, lying flat at the geometric centre of the tile
## (mobile visual pass: it used to sit on the inner band and straddled its
## edge). Turned to face the match camera (yaw 45°), so it reads upright on
## all four sides. Hidden once the tile has an owner (show_owner).
## PRICE_PLATE is the plate size in metres (long side along the text).
const PRICE_PLATE := Vector2(0.56, 0.28)
const BAND_DEPTH := 0.14
const BAND_CENTER := 0.37   # band spans 0.30..0.44 from the tile centre inwards
const TEXT_YAW := 45.0

func _build_price_label(root: Node3D, pid: String, accent: Color) -> void:
	var holder := Node3D.new()
	holder.name = "Price"
	holder.position = Vector3(0, TILE_H + 0.012, 0)
	holder.rotation_degrees = Vector3(-90, TEXT_YAW, 0)
	root.add_child(holder)
	var plate := Sprite3D.new()
	plate.name = "Plate"
	plate.texture = _plate_texture()
	plate.pixel_size = PRICE_PLATE.x / plate.texture.get_width()
	plate.modulate = Color.WHITE
	plate.shaded = false
	plate.double_sided = false
	plate.alpha_cut = SpriteBase3D.ALPHA_CUT_DISABLED
	plate.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	plate.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	plate.render_priority = 1
	holder.add_child(plate)
	var rim := Sprite3D.new()
	rim.name = "Rim"
	rim.texture = _plate_texture(true)
	rim.pixel_size = plate.pixel_size
	rim.modulate = accent.lerp(Color.WHITE, 0.15)
	rim.shaded = false
	rim.double_sided = false
	rim.alpha_cut = SpriteBase3D.ALPHA_CUT_DISABLED
	rim.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	rim.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	rim.render_priority = 2
	holder.add_child(rim)
	var l := Label3D.new()
	l.name = "Text"
	l.text = str(config.tier_of(pid)["price"])
	l.font = load("res://assets/fonts/BeVietnamPro-ExtraBold.ttf")
	l.font_size = 64
	l.pixel_size = 0.0036
	l.outline_size = 0
	l.modulate = Color("#fff6df")
	l.position = Vector3(0, 0, 0.002)
	l.shaded = false
	l.double_sided = false
	l.render_priority = 3
	l.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	holder.add_child(l)
	_price_labels[pid] = holder


static var _plate_tex := {}

## Rounded plate (navy, opaque) or its rim (white ring, tinted per district).
static func _plate_texture(rim := false) -> Texture2D:
	if _plate_tex.has(rim):
		return _plate_tex[rim]
	var w := 208
	var h := 108
	var r := 40.0
	var img := Image.create(w, h, false, Image.FORMAT_RGBA8)
	for y in h:
		for x in w:
			# Signed distance to a rounded rectangle (inside < 0).
			var qx := absf(x + 0.5 - w * 0.5) - (w * 0.5 - r)
			var qy := absf(y + 0.5 - h * 0.5) - (h * 0.5 - r)
			var d := Vector2(maxf(qx, 0.0), maxf(qy, 0.0)).length() + minf(maxf(qx, qy), 0.0) - r
			var a := clampf(0.5 - d, 0.0, 1.0)
			if rim:
				a *= clampf(d + 7.5, 0.0, 1.0)  # 7 px ring
				img.set_pixel(x, y, Color(1, 1, 1, a))
			else:
				img.set_pixel(x, y, Color(0.06, 0.09, 0.17, 0.92 * a))
	img.generate_mipmaps()
	_plate_tex[rim] = ImageTexture.create_from_image(img)
	return _plate_tex[rim]


## Flat icon on special tiles (SVG asset, rendered as a Sprite3D lying on the
## slab). The Start tile also carries its label.
func _build_special_icon(root: Node3D, stype: String, accent: Color) -> void:
	var icon_name: String = theme.special[stype].get("icon", "")
	if icon_name == "":
		return
	var s := Sprite3D.new()
	s.texture = load(ICON % icon_name)
	s.pixel_size = 0.62 / maxf(1.0, s.texture.get_width())
	s.rotation_degrees = Vector3(-90, 45, 0)
	s.position.y = TILE_H + 0.012
	s.modulate = accent.darkened(0.45)
	s.shaded = false
	s.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	s.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	root.add_child(s)
	if stype == "START":
		s.position += Vector3(-0.12, 0, -0.12)
		s.pixel_size *= 0.7
		var label := Label3D.new()
		label.text = theme.special[stype]["glyph"]
		label.font = load("res://assets/fonts/BeVietnamPro-ExtraBold.ttf")
		label.font_size = 64
		label.pixel_size = 0.0036
		label.outline_size = 0
		label.modulate = accent.darkened(0.55)
		label.rotation_degrees = Vector3(-90, 45, 0)
		label.position = Vector3(0.1, TILE_H + 0.014, 0.1)
		root.add_child(label)


func _build_highlight() -> void:
	# Glowing frame around the active tile (merged, one draw call).
	var mm := MeshMerger.new()
	for s in [-1, 1]:
		mm.add_kit(kit("unit_window_glow"), Transform3D(Basis().scaled(Vector3(0.96, 0.02, 0.035)), Vector3(0, 0.02, s * 0.465)), Color("#ffd27a"))
		mm.add_kit(kit("unit_window_glow"), Transform3D(Basis().scaled(Vector3(0.035, 0.02, 0.96)), Vector3(s * 0.465, 0.02, 0)), Color("#ffd27a"))
	_highlight = mm.instance("Highlight")
	_highlight.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_highlight.visible = false
	add_child(_highlight)


# --- dynamic state ----------------------------------------------------------------

func tile_position(index: int) -> Vector3:
	return BoardLayout.position_of(index) + Vector3(0, TILE_H, 0)


const OWNER_BADGE_SIZE := 0.25
static var _badge_tex := {}

## Round badge: the persona portrait inside a ring of the seat colour (cached
## per seat and colour). Null when the seat has no portrait.
func owner_badge_texture(seat: int) -> Texture2D:
	var face := theme.player_portrait(seat)
	if face == null:
		return null
	var col := theme.player_color(seat)
	var key := "%d|%s" % [seat, col.to_html()]
	if _badge_tex.has(key):
		return _badge_tex[key]
	var n := 128
	var src := face.get_image()
	if src == null:
		return face
	src = src.duplicate()
	if src.is_compressed():
		src.decompress()
	src.convert(Image.FORMAT_RGBA8)
	var inner := 90
	src.resize(inner, inner, Image.INTERPOLATE_LANCZOS)
	var img := Image.create(n, n, false, Image.FORMAT_RGBA8)
	var c := n * 0.5
	for y in n:
		for x in n:
			var d := Vector2(x + 0.5 - c, y + 0.5 - c).length()
			var a_out := clampf(c - 1.0 - d, 0.0, 1.0)
			if a_out <= 0.0:
				continue
			var ring := col
			if d > c - 4.0:
				ring = Color(0.04, 0.06, 0.12)   # dark outline: reads on light tiles
			var px := ring
			var ix := x - (n - inner) / 2
			var iy := y - (n - inner) / 2
			if d < inner * 0.5 - 0.5 and ix >= 0 and iy >= 0 and ix < inner and iy < inner:
				var f := src.get_pixel(ix, iy)
				px = ring.lerp(Color(f.r, f.g, f.b), f.a)
			img.set_pixel(x, y, Color(px.r, px.g, px.b, a_out))
	img.generate_mipmaps()
	_badge_tex[key] = ImageTexture.create_from_image(img)
	return _badge_tex[key]


## Ownership: a frame in the owner's colour around the slab plus a flag on the
## lot corner. The tile and building keep their own materials, so the
## architecture stays readable (art direction: identity colour never covers
## the whole tile).
func show_owner(pid: String, seat: int) -> void:
	if _price_labels.has(pid):
		_price_labels[pid].visible = seat < 0
	if _owner_marks.has(pid):
		_owner_marks[pid].queue_free()
		_owner_marks.erase(pid)
	if _owner_badges.has(pid):
		_owner_badges[pid].queue_free()
		_owner_badges.erase(pid)
	if seat < 0:
		return
	var c := theme.player_color(seat)
	var lot: Node3D = _lots[pid]
	var mm := MeshMerger.new()
	# Frame strips, authored in tile space and mapped into the (offset,
	# rotated) lot space the mark lives in.
	var to_lot := Transform3D(lot.basis, lot.position).affine_inverse()
	# Phase 5.1: a bolder frame (it read as a hairline from the overview
	# camera) and a taller flag.
	for s in [-1, 1]:
		mm.add_kit(kit("unit_paint"), to_lot * Transform3D(Basis.from_scale(Vector3(0.94, 0.016, 0.11)), Vector3(0, TILE_H + 0.006, s * 0.415)), c)
		mm.add_kit(kit("unit_paint"), to_lot * Transform3D(Basis.from_scale(Vector3(0.11, 0.016, 0.94)), Vector3(s * 0.415, TILE_H + 0.006, 0)), c)
	var corner := Vector3(0.24, 0.0, 0.24)
	mm.add_kit(kit("flag_pole"), Transform3D(Basis.from_scale(Vector3.ONE * 1.5), corner))
	mm.add_kit(kit("flag_cloth"), Transform3D(Basis.from_scale(Vector3.ONE * 1.5), corner), c)
	var flag := mm.instance("Owner")
	lot.add_child(flag)
	# Mobile visual pass: the owner's badge (portrait in a ring of the owner's
	# colour) floats upright over the tile's outer edge, always facing the
	# camera and drawn over buildings, so ownership reads at a glance on a
	# phone - not only through the colour of a thin frame.
	var badge_tex := owner_badge_texture(seat)
	if badge_tex:
		var badge := Sprite3D.new()
		badge.name = "OwnerBadge"
		badge.texture = badge_tex
		badge.pixel_size = OWNER_BADGE_SIZE / badge_tex.get_width()
		badge.billboard = BaseMaterial3D.BILLBOARD_ENABLED
		badge.shaded = false
		badge.no_depth_test = true
		badge.render_priority = 3
		badge.alpha_cut = SpriteBase3D.ALPHA_CUT_DISABLED
		badge.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
		badge.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		# Outer edge of the tile (away from the street), above the lot.
		var tile_root: Node3D = _tiles[_lot_tile[pid]]
		var inward := BoardLayout.inward(_lot_tile[pid])
		badge.position = tile_root.position + Vector3(-inward.x, 0, -inward.z) * 0.3 + Vector3(0, 0.46, 0)
		add_child(badge)
		_owner_badges[pid] = badge
		badge.scale = Vector3.ONE * 0.01
		create_tween().tween_property(badge, "scale", Vector3.ONE, 0.35).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	_owner_marks[pid] = flag
	flag.scale = Vector3.ONE * 0.01
	create_tween().tween_property(flag, "scale", Vector3.ONE, 0.35).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)


## Shows building level 0..3 for a property (0 = empty lot). The model comes
## from the district's architectural family (assets/models/buildings).
func show_level(pid: String, level: int, seat: int, animate := true) -> void:
	if _levels.get(pid, -1) == level:
		return
	_levels[pid] = level
	var lot: Node3D = _lots[pid]
	var old := lot.get_node_or_null("Building")
	if old:
		# Detach now: a queued node would keep the name and the new building
		# would be auto-renamed, so the next upgrade could not find it.
		lot.remove_child(old)
		old.queue_free()
	var old_shadow := lot.get_node_or_null("ContactShadow")
	if old_shadow:
		lot.remove_child(old_shadow)
		old_shadow.queue_free()
	if level <= 0:
		return
	lot.add_child(contact_shadow_node(0.3 + 0.04 * level))
	var did: String = config.spaces[_lot_tile[pid]]["district_id"]
	var b := MeshInstance3D.new()
	b.name = "Building"
	b.mesh = load(BUILDING % [did.to_lower(), clampi(level, 1, 3)])
	b.scale = Vector3.ONE * BUILDING_SCALE
	lot.add_child(b)
	if animate:
		b.scale = Vector3(BUILDING_SCALE, 0.01, BUILDING_SCALE)
		create_tween().tween_property(b, "scale", Vector3.ONE * BUILDING_SCALE, 0.5).set_trans(Tween.TRANS_ELASTIC).set_ease(Tween.EASE_OUT)


## Low preset: the tabletop drops its fine grain (fewer ALU ops per pixel).
func set_water_lite(lite: bool) -> void:
	(_table.material_override as ShaderMaterial).set_shader_parameter("grain", 0.0 if lite else 1.0)


func set_highlight(index: int) -> void:
	if index < 0:
		_highlight.visible = false
		return
	_highlight.visible = true
	_highlight.position = tile_position(index) + Vector3(0, 0.004, 0)


## Floating state icon over a tile: "auction" (gavel) or "upgrade" (arrow).
## The HUD drives this from what the player can do; it never reads rules.
func set_tile_marker(index: int, kind: String, on: bool) -> void:
	var key := "%s:%d" % [kind, index]
	if not on:
		if _markers.has(key):
			_markers[key].queue_free()
			_markers.erase(key)
		return
	if _markers.has(key):
		return
	var spec: Array = MARKERS[kind]
	var s := Sprite3D.new()
	s.texture = load(ICON % spec[0])
	s.pixel_size = 0.38 / maxf(1.0, s.texture.get_width())
	s.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	s.no_depth_test = true
	s.render_priority = 2
	s.modulate = spec[1]
	s.shaded = false
	s.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	s.position = tile_position(index) + Vector3(0, 0.75 + (0.35 if _level_at(index) >= 2 else 0.0), 0)
	add_child(s)
	_markers[key] = s
	var base_y := s.position.y
	var t := s.create_tween().set_loops()
	t.tween_property(s, "position:y", base_y + 0.08, 0.6).set_trans(Tween.TRANS_SINE)
	t.tween_property(s, "position:y", base_y, 0.6).set_trans(Tween.TRANS_SINE)


func clear_tile_markers(kind: String) -> void:
	for key in _markers.keys():
		if str(key).begins_with(kind + ":"):
			_markers[key].queue_free()
			_markers.erase(key)


func marker_count(kind: String) -> int:
	return _markers.keys().filter(func(k): return str(k).begins_with(kind + ":")).size()


func _level_at(index: int) -> int:
	for pid in _lot_tile:
		if _lot_tile[pid] == index:
			return _levels.get(pid, 0)
	return 0


func pick(camera: Camera3D, screen_pos: Vector2) -> int:
	var from := camera.project_ray_origin(screen_pos)
	var dir := camera.project_ray_normal(screen_pos)
	var q := PhysicsRayQueryParameters3D.create(from, from + dir * 100.0)
	var hit := get_world_3d().direct_space_state.intersect_ray(q)
	if hit.is_empty() or not hit["collider"].has_meta("tile_index"):
		return -1
	return hit["collider"].get_meta("tile_index")
