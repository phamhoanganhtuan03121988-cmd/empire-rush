## Mobile UI design system (M2.3; tokens documented in
## docs/art_direction/ART_DIRECTION.md). Sizes target iPhone 14 Pro (393 pt
## wide): the design viewport is 720 px wide, so 1 pt ≈ 1.83 px; buttons are
## >= 88 px (~48 pt) and information text >= 20 px (~11 pt).
## Typeface: Be Vietnam Pro (SIL OFL 1.1, assets/fonts) - full Vietnamese
## diacritics. Buttons and panels use 9-slice skins from assets/ui/skin
## (generated by tools/asset_forge/ui_gen.gd), so they stretch to any size.
class_name UiTheme
extends RefCounted

# --- colour tokens --------------------------------------------------------------
const NAVY := Color("#121a2e")          # panel base
const NAVY_SOFT := Color("#1e2a48")     # raised surface / active card
const GOLD := Color("#f5b83d")          # primary accent, money, titles
const GOLD_DARK := Color("#b9821c")
const INK := Color("#1d1606")           # text on gold
const TEXT := Color("#f6f1e7")          # primary text on navy
const TEXT_MUTED := Color(0.96, 0.94, 0.9, 0.72)
const RED := Color("#e0574c")           # danger / losses
const BLUE := Color("#3f74de")          # secondary actions
const GREEN := Color("#5fd38a")         # gains / success
const AMBER := Color("#ffcf5a")         # warnings, auctions

const MIN_TOUCH := 88
## Smallest font for information text: 20 px ≈ 11 pt on a 393 pt-wide phone.
const MIN_FONT := 20
## Type scale (px at the 720 px design width).
const FS_CAPTION := 20
const FS_BODY := 24
const FS_LABEL := 26
const FS_BUTTON := 28
const FS_TITLE := 30
const FS_NUMBER := 30
const RADIUS := 16
const SPACE := 10

const FONT_DIR := "res://assets/fonts/BeVietnamPro-%s.ttf"
const SKIN_DIR := "res://assets/ui/skin/%s.png"
const ICON_DIR := "res://assets/ui/icons/%s.svg"

static var _cache: Dictionary = {}


static func font(weight := "Medium") -> Font:
	var key := "font:" + weight
	if not _cache.has(key):
		_cache[key] = load(FONT_DIR % weight)
	return _cache[key]


static func icon(name: String) -> Texture2D:
	var key := "icon:" + name
	if not _cache.has(key):
		_cache[key] = load(ICON_DIR % name)
	return _cache[key]


## 9-slice style box from a generated skin. `lip` is the bottom lip height of
## button skins (pressed skins have none, so content shifts down = feels pressed).
static func skin(name: String, margin := 16, pad := Vector4(22, 12, 22, 12), lip := 0) -> StyleBoxTexture:
	var key := "skin:%s:%d:%s:%d" % [name, margin, str(pad), lip]
	if _cache.has(key):
		return _cache[key]
	var s := StyleBoxTexture.new()
	s.texture = load(SKIN_DIR % name)
	# Skins are authored at 2x: margins are in texture pixels.
	s.texture_margin_left = margin * 2
	s.texture_margin_right = margin * 2
	s.texture_margin_top = margin * 2
	s.texture_margin_bottom = (margin + lip) * 2
	s.content_margin_left = pad.x
	s.content_margin_top = pad.y
	s.content_margin_right = pad.z
	s.content_margin_bottom = pad.w + lip
	_cache[key] = s
	return s


static func panel(bg := NAVY, border := Color(1, 1, 1, 0.12), radius := 22, alpha := 0.92) -> StyleBoxFlat:
	var s := StyleBoxFlat.new()
	s.bg_color = Color(bg, alpha)
	s.set_corner_radius_all(radius)
	s.set_border_width_all(2)
	s.border_color = border
	s.content_margin_left = 18
	s.content_margin_right = 18
	s.content_margin_top = 14
	s.content_margin_bottom = 14
	s.shadow_color = Color(0, 0, 0, 0.35)
	s.shadow_size = 8
	return s


static func glass_panel(gold := false) -> StyleBoxTexture:
	return skin("panel_gold" if gold else "panel", 24, Vector4(20, 16, 20, 16))


static func build() -> Theme:
	var th := Theme.new()
	th.default_font = font("Medium")
	th.default_font_size = FS_BODY
	th.set_color("font_color", "Label", TEXT)
	th.set_constant("outline_size", "Label", 0)
	th.set_constant("line_spacing", "Label", 2)
	_button_styles(th, "Button", "btn_primary", "btn_primary_pressed", INK)
	th.set_font("font", "Button", font("Bold"))
	th.set_font_size("font_size", "Button", FS_BUTTON)
	th.set_constant("icon_max_width", "Button", 40)
	th.set_constant("h_separation", "Button", 12)
	th.set_stylebox("panel", "PanelContainer", glass_panel())
	# Scrollbars: slim and unobtrusive (touch scrolling does the work).
	var grab := StyleBoxFlat.new()
	grab.bg_color = Color(1, 1, 1, 0.35)
	grab.set_corner_radius_all(4)
	grab.content_margin_left = 3
	grab.content_margin_right = 3
	th.set_stylebox("grabber", "VScrollBar", grab)
	th.set_stylebox("grabber_highlight", "VScrollBar", grab)
	th.set_stylebox("grabber_pressed", "VScrollBar", grab)
	th.set_stylebox("scroll", "VScrollBar", StyleBoxEmpty.new())
	return th


static func _button_styles(th: Theme, type: String, normal: String, pressed: String, ink: Color) -> void:
	th.set_stylebox("normal", type, skin(normal, 16, Vector4(22, 12, 22, 12), 6))
	th.set_stylebox("hover", type, skin(normal, 16, Vector4(22, 12, 22, 12), 6))
	th.set_stylebox("pressed", type, skin(pressed, 16, Vector4(22, 16, 22, 8), 0))
	th.set_stylebox("disabled", type, skin("btn_disabled", 16, Vector4(22, 12, 22, 12), 6))
	var focus := StyleBoxFlat.new()
	focus.bg_color = Color(0, 0, 0, 0)
	focus.set_border_width_all(3)
	focus.border_color = Color(1, 1, 1, 0.85)
	focus.set_corner_radius_all(RADIUS + 2)
	focus.set_expand_margin_all(3)
	th.set_stylebox("focus", type, focus)
	for c in ["font_color", "font_hover_color", "font_pressed_color", "font_focus_color", "font_hover_pressed_color"]:
		th.set_color(c, type, ink)
	th.set_color("font_disabled_color", type, Color(0.88, 0.88, 0.9, 0.75))
	for c in ["icon_normal_color", "icon_hover_color", "icon_pressed_color", "icon_focus_color", "icon_hover_pressed_color"]:
		th.set_color(c, type, ink)
	th.set_color("icon_disabled_color", type, Color(0.88, 0.88, 0.9, 0.6))


static func _apply(b: Button, normal: String, pressed: String, ink: Color) -> void:
	b.add_theme_stylebox_override("normal", skin(normal, 16, Vector4(22, 12, 22, 12), 6))
	b.add_theme_stylebox_override("hover", skin(normal, 16, Vector4(22, 12, 22, 12), 6))
	b.add_theme_stylebox_override("pressed", skin(pressed, 16, Vector4(22, 16, 22, 8), 0))
	for c in ["font_color", "font_hover_color", "font_pressed_color", "font_focus_color", "font_hover_pressed_color",
			"icon_normal_color", "icon_hover_color", "icon_pressed_color", "icon_focus_color", "icon_hover_pressed_color"]:
		b.add_theme_color_override(c, ink)


## Secondary action (blue): pass, back, end turn, alternatives.
static func secondary(b: Button) -> void:
	_apply(b, "btn_secondary", "btn_secondary_pressed", Color.WHITE)


## Destructive action (red): bankruptcy, reject.
static func danger(b: Button) -> void:
	_apply(b, "btn_danger", "btn_danger_pressed", Color.WHITE)


## Low-emphasis control (slate): settings, close.
static func neutral(b: Button) -> void:
	_apply(b, "btn_neutral", "btn_neutral_pressed", Color.WHITE)


## Round badge (player avatar / rank medal) as a flat style box.
static func badge(color: Color, border := Color(1, 1, 1, 0.85)) -> StyleBoxFlat:
	var s := StyleBoxFlat.new()
	s.bg_color = color
	s.set_corner_radius_all(64)
	s.set_border_width_all(2)
	s.border_color = border
	s.set_content_margin_all(4)
	return s
